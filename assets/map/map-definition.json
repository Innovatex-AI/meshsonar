  "defaultBasemap": "road",
  "groups": [
    {
      "id": "coverage",
      "name": "Coverage"
    },
    {
      "id": "network",
      "name": "Network"
    },
    {
      "id": "context",
      "name": "Context"
    }
  ],
  "layers": [
    {
      "id": "borders",
      "name": "Region borders",
      "group": "context",
      "defaultOn": true,
      "minZoom": 0,
      "maxZoom": 22,
      "source": {
        "type": "geojson",
        "endpoint": "/api/cmh/regions-index"
      },
      "style": "border",
      "tap": "none",
      "legend": [
        {
          "kind": "symbol",
          "symbol": "border",
          "label": "Region border"
        }
      ]
    },
    {
      "id": "predicted",
      "name": "Predicted coverage",
      "group": "coverage",
      "defaultOn": true,
      "minZoom": 8,
      "maxZoom": 22,
      "source": {
        "type": "mvt",
        "url": "/api/coverage/tiles/predicted/{z}/{x}/{y}.mvt?preset={preset}&v={version}",
        "sourceLayer": "predicted",
        "minzoom": 8,
        "maxzoom": 16
      },
      "style": "coverage-predicted",
      "tap": "cell",
      "hidesWithTime": true,
      "hint": "An estimate for undriven cells within 1 km of a measurement.",
      "legend": [
        {
          "kind": "hatch",
          "band": 4,
          "label": "Predicted coverage: an estimate from nearby measured cells, fainter further out"
        }
      ]
    },
    {
      "id": "heard",
      "name": "Heard by phones",
      "group": "coverage",
      "defaultOn": true,
      "minZoom": 0,
      "maxZoom": 22,
      "source": {
        "type": "mvt",
        "url": "/api/coverage/tiles/heard/{z}/{x}/{y}.mvt?preset={preset}&v={version}",
        "sourceLayer": "heard",
        "minzoom": 0,
        "maxzoom": 16
      },
      "style": "coverage-heard",
      "tap": "cell",
      "hidesWithTime": true,
      "hint": "Cells where a MeshSonar phone heard a repeater without pinging.",
      "legend": [
        {
          "kind": "outline",
          "band": 4,
          "label": "Heard by phones: a phone heard a repeater here without pinging, in the colour of the average SNR it heard (not a measurement)"
        }
      ]
    },
    {
      "id": "measured",
      "name": "Measured coverage",
      "group": "coverage",
      "defaultOn": true,
      "minZoom": 0,
      "maxZoom": 22,
      "source": {
        "type": "mvt",
        "url": "/api/coverage/tiles/measured/{z}/{x}/{y}.mvt?preset={preset}&v={version}",
        "sourceLayer": "measured",
        "minzoom": 0,
        "maxzoom": 16
      },
      "style": "coverage-measured",
      "tap": "cell",
      "legend": [
        {
          "kind": "bands",
          "from": 5,
          "to": 1,
          "note": "SNR, the average of the pings in each cell"
        },
        {
          "kind": "band",
          "band": 0,
          "label": "No reply"
        },
        {
          "kind": "band",
          "band": 6,
          "label": "Heard, no direct signal"
        },
        {
          "kind": "faint",
          "label": "Faint = under 3 pings"
        }
      ]
    },
    {
      "id": "redundancy",
      "name": "Redundancy",
      "group": "coverage",
      "defaultOn": false,
      "minZoom": 0,
      "maxZoom": 22,
      "source": {
        "type": "geojson",
        "endpoint": "/api/cmh/region-link-graph?sources=measured&drive=1 (drive rows: [repeaterIdx, h3, attempts, snrMean], count distinct repeaterIdx per h3)"
      },
      "style": "redundancy",
      "tap": "none",
      "hidesWithTime": true,
      "hint": "How many repeaters were measured in each cell; one is a single point of failure.",
      "legend": [
        {
          "kind": "step",
          "step": 1,
          "label": "1 repeater: a single point of failure"
        },
        {
          "kind": "step",
          "step": 2,
          "label": "2 repeaters"
        },
        {
          "kind": "step",
          "step": 3,
          "label": "3 repeaters"
        },
        {
          "kind": "step",
          "step": 4,
          "label": "4 or more repeaters"
        }
      ]
    },
    {
      "id": "drive",
      "name": "This drive",
      "group": "coverage",
      "defaultOn": true,
      "minZoom": 0,
      "maxZoom": 22,
      "source": {
        "type": "local",
        "what": "a drive's res-11 mean cells and pings"
      },
      "style": "drive",
      "tap": "none",
      "panelOnly": true,
      "legend": [
        {
          "kind": "symbol",
          "symbol": "ping",
          "state": "heard",
          "label": "Ping a repeater answered (colour = its SNR band)"
        },
        {
          "kind": "symbol",
          "symbol": "ping",
          "state": "none",
          "label": "Ping nobody answered"
        }
      ]
    },
    {
      "id": "snrlinks",
      "name": "Links by SNR",
      "group": "network",
      "defaultOn": false,
      "minZoom": 0,
      "maxZoom": 22,
      "source": {
        "type": "geojson",
        "endpoint": "/api/cmh/region-link-graph?drive=0 (link rows: [aIdx, bIdx, source, width, snrDb, snrN, rssi, n, feeds, mix, lastAt, km])"
      },
      "style": "snr-link",
      "tap": "none",
      "hint": "Repeater-to-repeater links: colour is the SNR, width the packets seen.",
      "legend": [
        {
          "kind": "bands",
          "from": 5,
          "to": 1,
          "note": "Link SNR (reported neighbour tables and measured /neighbors reports)"
        },
        {
          "kind": "symbol",
          "symbol": "snrlink",
          "state": "none",
          "label": "Seen relaying, no SNR (width = packets)"
        }
      ]
    },
    {
      "id": "links",
      "name": "Link lines",
      "group": "network",
      "defaultOn": true,
      "minZoom": 0,
      "maxZoom": 22,
      "source": {
        "type": "geojson",
        "endpoint": "/api/cmh/repeater-reach | /api/cmh/cell-links"
      },
      "style": "link",
      "tap": "none",
      "hint": "Tap a repeater or a cell to draw its lines.",
      "legend": [
        {
          "kind": "symbol",
          "symbol": "link",
          "label": "Link line: from the tapped repeater or cell; the label is the SNR"
        }
      ]
    },
    {
      "id": "network",
      "name": "All MeshCore repeaters",
      "group": "network",
      "defaultOn": false,
      "minZoom": 0,
      "maxZoom": 22,
      "source": {
        "type": "geojson",
        "endpoint": "/api/cmh/network-repeaters"
      },
      "style": "repeater",
      "tap": "repeater",
      "hint": "Turn on to see every repeater in the country (loads about 4 MB).",
      "legend": []
    },
    {
      "id": "live",
      "name": "Live",
      "group": "network",
      "defaultOn": false,
      "minZoom": 0,
      "maxZoom": 22,
      "source": {
        "type": "local",
        "what": "the region's live packet stream"
      },
      "style": "live",
      "tap": "repeater",
      "panelOnly": true,
      "legend": [
        {
          "kind": "symbol",
          "symbol": "live",
          "label": "A packet travelling repeater to repeater"
        }
      ]
    },
    {
      "id": "repeaters",
      "name": "Repeaters",
      "group": "network",
      "defaultOn": true,
      "minZoom": 0,
      "maxZoom": 22,
      "source": {
        "type": "geojson",
        "endpoint": "/api/cmh/region-repeaters (hub: /api/cmh/network-repeaters)"
      },
      "style": "repeater",
      "tap": "repeater",
      "legend": [
        {
          "kind": "symbol",
          "symbol": "repeater",
          "state": "fresh",
          "label": "Repeater heard in the last 24 h (solid ring)"
        },
        {
          "kind": "symbol",
          "symbol": "repeater",
          "state": "recent",
          "label": "Heard in the last 7 days (dashed ring)"
        },
        {
          "kind": "symbol",
          "symbol": "repeater",
          "state": "stale",
          "label": "Not heard for over 7 days (faded)"
        }
      ],
      "controls": [
        {
          "id": "names",
          "name": "Names",
          "defaultOn": true,
          "urlKey": "names",
          "rule": "repeaterNames",
          "hint": "Name beside each repeater, from street zoom (z14); fewer when crowded."
        }
      ]
    },
    {
      "id": "estimated",
      "name": "Estimated positions",
      "group": "network",
      "defaultOn": true,
      "minZoom": 0,
      "maxZoom": 22,
      "source": {
        "type": "geojson",
        "endpoint": "/api/cmh/region-repeater-estimates"
      },
      "style": "repeater-estimated",
      "tap": "repeater",
      "hint": "Repeaters with no GPS, placed from their located neighbours; paler = less sure.",
      "legend": [
        {
          "kind": "symbol",
          "symbol": "estimated",
          "state": "high",
          "label": "Estimated position (3 or more neighbours), approximate"
        },
        {
          "kind": "symbol",
          "symbol": "estimated",
          "state": "low",
          "label": "Estimated position, low confidence (fewer or far-apart neighbours)"
        }
      ]
    },
    {
      "id": "observers",
      "name": "Observers",
      "group": "network",
      "defaultOn": true,
      "minZoom": 0,
      "maxZoom": 22,
      "source": {
        "type": "geojson",
        "endpoint": "/api/cmh/region-observers"
      },
      "style": "observer",
      "tap": "observer",
      "legend": [
        {
          "kind": "symbol",
          "symbol": "observer",
          "state": "online",
          "label": "Observer, online"
        },
        {
          "kind": "symbol",
          "symbol": "observer",
          "state": "offline",
          "label": "Observer, offline"
        }
      ]
    },
    {
      "id": "phones",
      "name": "Moving phones",
      "group": "network",
      "defaultOn": true,
      "minZoom": 0,
      "maxZoom": 22,
      "source": {
        "type": "geojson",
        "endpoint": "/api/cmh/region-observers (kind = mobile)"
      },
      "style": "phone",
      "tap": "observer",
      "hint": "MeshSonar phones listening while they move, at the centre of their ~5 km cell.",
      "legend": [
        {
          "kind": "symbol",
          "symbol": "phone",
          "label": "Moving phone (approximate, ~5 km; fades 10 min after last heard)"
        }
      ]
    }
  ],
  "palettes": [
    {
