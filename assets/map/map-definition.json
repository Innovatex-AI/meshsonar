        }
      }
    },
    {
      "id": "colour_blind",
      "name": "Colour-blind safe",
      "blurb": "Vermillion, orange, yellow, light blue and blue: warm is weak, cool is strong, never red against green. Link lines are dashed.",
      "themes": {
        "light": {
          "bands": [
            "#EA7267",
            "#592B21",
            "#B63202",
            "#988400",
            "#3887B8",
            "#2A3EAD",
