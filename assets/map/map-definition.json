    {
      "id": "satellite",
      "name": "Satellite",
      "description": "Aerial imagery: USGS NAIP in the US, Esri World Imagery elsewhere. Needs a connection.",
      "render": "raster",
      "vector": null,
      "fallbackStyle": null,
      "hillshade": null,
      "topo": null,
      "satellite": {
        "sources": [
          {
            "id": "esri",
            "name": "Esri World Imagery",
            "tiles": "https://meshsonar.com/api/map/satellite/esri/{z}/{y}/{x}",
            "tileSize": 256,
            "minzoom": 0,
            "maxzoom": 18,
            "bounds": [
              -180,
              -85.0511,
              180,
              85.0511
            ],
            "attribution": [
              "Powered by Esri. Source: Esri, Maxar, Earthstar Geographics, and the GIS User Community"
            ],
            "layerMaxZoom": null
          },
          {
            "id": "naip",
            "name": "USGS NAIP",
            "tiles": "https://basemap.nationalmap.gov/arcgis/rest/services/USGSImageryOnly/MapServer/tile/{z}/{y}/{x}",
            "tileSize": 256,
            "minzoom": 0,
            "maxzoom": 16,
            "bounds": [
              -125,
              24.4,
              -66.9,
              49.5
            ],
            "attribution": [
              "Imagery: USGS National Map (NAIP)"
            ],
            "layerMaxZoom": 17
          }
        ],
        "esriAvailable": true,
        "labels": {
          "from": "vector",
          "flavour": "black",
          "note": "Town and road names from our vector tiles, drawn over the imagery inside the basemap extract."
