{
  "about": "CMAT problem reports: canonical redaction and rounding vectors (docs/specs/m1-problem-reports.md section 8). Owned by Q. MeshSonar copies this file unchanged; both sides must produce every output and count exactly. Rules apply in order R1..R6 then C1 to each string; counts are the number of replacements per count key (R4 and R5 both count as mqtt).",
  "idempotence": "Applying the table to any vector's output must return the same text with every count 0 (L, Oct 17).",
  "countKeys": [
    "driverKey",
    "jwt",
    "bearer",
    "secret",
    "mqtt",
    "coords"
  ],
  "rules": [
    {
      "id": "R1",
      "name": "driver key",
      "count": "driverKey",
      "pattern": "\\bms_[A-Za-z0-9_-]{20,}",
      "flags": "g",
      "replace": "[redacted:driver-key]"
    },
    {
      "id": "R2",
      "name": "JWT",
      "count": "jwt",
      "pattern": "\\beyJ[A-Za-z0-9_-]{5,}\\.[A-Za-z0-9_-]{5,}\\.[A-Za-z0-9_-]*",
      "flags": "g",
      "replace": "[redacted:jwt]"
    },
    {
      "id": "R3",
      "name": "bearer",
      "count": "bearer",
      "pattern": "\\b(Bearer)\\s+[A-Za-z0-9._~+\\/-]+=*",
      "flags": "gi",
      "replace": "$1 [redacted]"
    },
    {
      "id": "R4",
      "name": "URL credentials",
      "count": "mqtt",
      "pattern": "\\b((?:mqtts?|wss?|https?|tcp|ssl):\\/\\/[^\\s:\\/@]+):(?!\\[redacted\\]@[^\\s\\/@]*(?:[\\s\\/]|$))[^\\s\\/]+@",
      "flags": "gi",
      "replace": "$1:[redacted]@"
    },
    {
      "id": "R5",
      "name": "observer CLI password",
      "count": "mqtt",
      "pattern": "\\b(set\\s+mqtt\\d*\\.(?:password|pass|token))\\s+(?!\\[redacted\\](?!\\S))\\S+",
      "flags": "gi",
      "replace": "$1 [redacted]"
    },
    {
      "id": "R6",
      "name": "secret field",
      "count": "secret",
      "pattern": "\\b(x-driver-key|x-admin-key|x-user-jwt|x-access-token|authorization|apikey|api_key|access_token|refresh_token|password|passwd|pwd|secret|token)([\"']?\\s*[:=]\\s*[\"']?)(?!\\[redacted|Bearer\\b)([^\\s\"',;&}]+)",
      "flags": "gi",
      "replace": "$1$2[redacted]"
    },
    {
      "id": "C1",
      "name": "coordinate in text",
      "count": "coords",
      "pattern": "(?<![\\d.])(-?)\\b(\\d{1,3}\\.\\d{4,})\\b(?!\\d|\\.\\d)",
      "flags": "g",
      "replace": "sign + value rounded to 3 decimals (sign x round(|v| x 1000) / 1000, half away from zero), printed with exactly 3 decimals; only when the value is <= 180"
    },
    {
      "id": "C2",
      "name": "coordinate field",
      "count": "coords",
      "pattern": null,
      "flags": null,
      "replace": "keys lat, lon, lng, latitude, longitude with a number value in device/radio: number rounded to 3 decimals; counted only when the value changed"
    }
  ],
  "vectors": [
